; The rewrite rules the `*_simplify` trace replay uses that cvc5's `rewrites.eo` does not
; declare. The `core-simp-rare` elaboration pass emits `rare_rewrite` steps over these rules
; (plus the ones of `rewrites.eo`), so checking its output needs a rule file that includes both.
; Naming follows the RARE catalogue of the core documentation (`docs/src/core/rare-rules.md`);
; shapes mirror Carcara's `*_simplify` checkers.

; ite_simplify
(declare-rare-rule ite-then-true-else-false ((c1 Bool))
  :args (c1)
  :conclusion (= (ite c1 true false) c1)
)
(declare-rare-rule ite-then-false-else-true ((c1 Bool))
  :args (c1)
  :conclusion (= (ite c1 false true) (not c1))
)

; implies_simplify
(declare-rare-rule implies-contra ((p1 Bool) (q1 Bool))
  :args (p1 q1)
  :conclusion (= (=> (not p1) (not q1)) (=> q1 p1))
)
(declare-rare-rule implies-refl ((p1 Bool))
  :args (p1)
  :conclusion (= (=> p1 p1) true)
)
(declare-rare-rule implies-neg-l ((p1 Bool))
  :args (p1)
  :conclusion (= (=> (not p1) p1) p1)
)
(declare-rare-rule implies-neg-r ((p1 Bool))
  :args (p1)
  :conclusion (= (=> p1 (not p1)) (not p1))
)
(declare-rare-rule bool-implies-peirce ((p1 Bool) (q1 Bool))
  :args (p1 q1)
  :conclusion (= (=> (=> p1 q1) q1) (or p1 q1))
)

; bool_simplify
(declare-rare-rule bool-implies-uncurry ((p1 Bool) (q1 Bool) (r1 Bool))
  :args (p1 q1 r1)
  :conclusion (= (=> p1 (=> q1 r1)) (=> (and p1 q1) r1))
)
(declare-rare-rule bool-and-mp-r ((p1 Bool) (q1 Bool))
  :args (p1 q1)
  :conclusion (= (and p1 (=> p1 q1)) (and p1 q1))
)
(declare-rare-rule bool-and-mp-l ((p1 Bool) (q1 Bool))
  :args (p1 q1)
  :conclusion (= (and (=> p1 q1) p1) (and p1 q1))
)

; equiv_simplify
(declare-rare-rule equiv-neg-both ((p1 Bool) (q1 Bool))
  :args (p1 q1)
  :conclusion (= (= (not p1) (not q1)) (= p1 q1))
)
(declare-rare-rule equiv-neg-l ((p1 Bool))
  :args (p1)
  :conclusion (= (= (not p1) p1) false)
)
(declare-rare-rule equiv-true-l ((p1 Bool))
  :args (p1)
  :conclusion (= (= true p1) p1)
)
(declare-rare-rule equiv-false-l ((p1 Bool))
  :args (p1)
  :conclusion (= (= false p1) (not p1))
)

; comp_simplify (the veriT shapes; the arith-elim-* rules of rewrites.eo use different
; right-hand sides)
(declare-rare-rule comp-lt-irrefl ((@T0 Type) (s1 @T0))
  :args (s1)
  :conclusion (= (< s1 s1) false)
)
(declare-rare-rule comp-lt-elim ((@T0 Type) (@T1 Type) (s1 @T0) (s2 @T1))
  :args (s1 s2)
  :conclusion (= (< s1 s2) (not (<= s2 s1)))
)
(declare-rare-rule comp-leq-refl ((@T0 Type) (s1 @T0))
  :args (s1)
  :conclusion (= (<= s1 s1) true)
)
(declare-rare-rule comp-geq-flip ((@T0 Type) (@T1 Type) (s1 @T0) (s2 @T1))
  :args (s1 s2)
  :conclusion (= (>= s1 s2) (<= s2 s1))
)
(declare-rare-rule comp-gt-elim ((@T0 Type) (@T1 Type) (s1 @T0) (s2 @T1))
  :args (s1 s2)
  :conclusion (= (> s1 s2) (not (<= s1 s2)))
)

; and_simplify / or_simplify
; and-flatten / or-flatten (the singleton unwrap) are deliberately absent, and not because RARE
; is lacking: a singleton application of an n-ary connective is not a well-formed Alethe term at
; all, so there is nothing for a rule to state. RARE agrees, normalizing `(or x)` to `x`. veriT
; nevertheless emits such terms, so the elaboration keeps a two-step core derivation
; (`or_pos`/`or_neg`) for those links; the fix belongs upstream.
(declare-rare-rule and-true-elim ((xs1 Bool :list) (ys1 Bool :list))
  :args (xs1 ys1)
  :conclusion (= (and xs1 true ys1) (and xs1 ys1))
)
(declare-rare-rule or-false-elim ((xs1 Bool :list) (ys1 Bool :list))
  :args (xs1 ys1)
  :conclusion (= (or xs1 false ys1) (or xs1 ys1))
)
(declare-rare-rule and-dup-elim ((xs1 Bool :list) (b1 Bool) (ys1 Bool :list) (zs1 Bool :list))
  :args (xs1 b1 ys1 zs1)
  :conclusion (= (and xs1 b1 ys1 b1 zs1) (and xs1 b1 ys1 zs1))
)
(declare-rare-rule or-dup-elim ((xs1 Bool :list) (b1 Bool) (ys1 Bool :list) (zs1 Bool :list))
  :args (xs1 b1 ys1 zs1)
  :conclusion (= (or xs1 b1 ys1 b1 zs1) (or xs1 b1 ys1 zs1))
)
(declare-rare-rule and-false ((xs1 Bool :list) (ys1 Bool :list))
  :args (xs1 ys1)
  :conclusion (= (and xs1 false ys1) false)
)
(declare-rare-rule or-true ((xs1 Bool :list) (ys1 Bool :list))
  :args (xs1 ys1)
  :conclusion (= (or xs1 true ys1) true)
)

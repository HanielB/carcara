(declare-rare-rule bv-or-concat-pullup2 ((@n0 Int) (@n1 Int) (@n2 Int) (@n3 Int) (@n4 Int) (xs1 (BitVec @n0) :list) (ws1 (BitVec @n1) :list) (y1 (BitVec @n2)) (z1 (BitVec @n3)) (ys1 (BitVec @n4) :list) (nxm1 Int) (ny1 Int) (nym1 Int))
  :premises ((= ny1 (- (@bvsize (concat z1 y1 ys1)) (@bvsize z1))) (= nxm1 (- (@bvsize (concat z1 y1 ys1)) 1)) (= nym1 (- (- (@bvsize (concat z1 y1 ys1)) (@bvsize z1)) 1)))
  :args (xs1 ws1 y1 z1 ys1 nxm1 ny1 nym1)

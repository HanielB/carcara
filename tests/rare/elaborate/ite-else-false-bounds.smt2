(set-logic QF_LRA)
(declare-const p1 Bool)
(declare-const y1 Real)
(declare-const p2 Bool)
(declare-const y2 Real)
(declare-const p3 Bool)
(declare-const y3 Real)
(assert (ite (and (not p1) (not p2) (not p3)) (and (not (>= (* (- 1.0) y1) 0.0)) (not (>= (* (- 1.0) y2) 0.0)) (not (>= (* (- 1.0) y3) 0.0))) false))
(assert (not (and (not p1) (not p2) (not p3) (not (>= (* (- 1.0) y1) 0.0)) (not (>= (* (- 1.0) y2) 0.0)) (not (>= (* (- 1.0) y3) 0.0)))))
(check-sat)

(set-logic QF_UFLIA)
(declare-sort U 0)
(declare-const a U)
(declare-const b U)
(declare-const u U)
(declare-fun f (U) U)
(declare-const c Bool)
(declare-const p Bool)
(declare-const x Int)
(assert (not (= (and p (or (= a b) (= (f (ite c u u)) b)) (not (< x 1))) (and p (or (= b a) (= (f u) b)) (not (<= x 0))))))
(check-sat)
